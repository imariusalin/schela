#!/bin/bash
# Apply /var/lib/schela/state.json onto this machine. Idempotent. Root only.
set -euo pipefail

STATE="${SCHELA_STATE:-/var/lib/schela/state.json}"
TEMPLATES="${SCHELA_TEMPLATES:-/usr/local/share/schela/templates}"
DRY=0
[ "${1:-}" = "--dry-run" ] && DRY=1

log() { printf 'schela-apply: %s\n' "$*"; }
die() { printf 'schela-apply: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing $1"; }

ok_domain() { [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$ ]]; }
ok_user()   { [[ "$1" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; }
ok_php()    { [[ "$1" =~ ^8\.[1-4]$ ]]; }
ok_node()   { [[ "$1" =~ ^(18|20|22)$ ]]; }
ok_port()   { [[ "$1" =~ ^[0-9]{1,5}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
ok_ipv4()   { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }

bind_http() {
  ip="${1:-}"
  if ok_ipv4 "$ip"; then
    printf '%s:80' "$ip"
  else
    printf '80;\n    listen [::]:80'
  fi
}

bind_https() {
  ip="${1:-}"
  if ok_ipv4 "$ip"; then
    printf '%s:443 ssl http2' "$ip"
  else
    printf '443 ssl http2;\n    listen [::]:443 ssl http2'
  fi
}

nologin_shell() { command -v nologin 2>/dev/null || echo /usr/sbin/nologin; }

# Run a command as a site user. Everything below /home/<user> belongs to that
# user, who can replace any entry there (for example turn www into a symlink),
# so files inside the home are created and changed with the user's own
# permissions, never root's.
as_user() {
  local user="$1"
  shift
  runuser -u "$user" -- "$@"
}

# /home/<user> itself: created by root if missing (useradd normally does it).
# /home is root-owned, so only root could have made this path a link; refuse
# one rather than change whatever it points at.
ensure_home() {
  local user="$1" home="/home/$1"
  if [ -L "$home" ]; then
    log "skip $user: $home is a symlink"
    return 1
  fi
  [ -d "$home" ] || install -d -o "$user" -g "$user" -m 750 "$home"
  chown "$user:$user" "$home"
  chmod 750 "$home"
}

[ "$(id -u)" -eq 0 ] || die "root required"
need jq
need nginx
[ -f "$STATE" ] || die "no state at $STATE"

mod_on() {
  jq -e --arg s "$1" '.modules[$s] == true' "$STATE" >/dev/null 2>&1
}

write_file() {
  dest="$1"
  content="$2"
  if [ "$DRY" -eq 1 ]; then
    log "would write $dest"
    return
  fi
  tmp="$(mktemp)"
  printf '%s\n' "$content" >"$tmp"
  install -m 0644 "$tmp" "$dest"
  rm -f "$tmp"
}

render() {
  src="$1"
  shift
  out="$(cat "$src")"
  while [ "$#" -ge 2 ]; do
    out="${out//$1/$2}"
    shift 2
  done
  printf '%s' "$out"
}

ACME_ROOT="/var/lib/schela/acme"
CERTS_JSON="/var/lib/schela/certs.json"

wants_ssl() {
  case "${1:-}" in true|1|t|yes) ;; *) return 1 ;; esac
  [[ ! "${2:-}" =~ \.(example|local|test)$ ]]
}

cert_live() {
  [ -s "/etc/letsencrypt/live/${1}/fullchain.pem" ] && [ -s "/etc/letsencrypt/live/${1}/privkey.pem" ]
}

truthy() {
  case "${1:-}" in true|1|t|yes) return 0 ;; *) return 1 ;; esac
}

ensure_user() {
  user="$1"
  home="$2"
  ok_user "$user" || die "bad user $user"
  if [ "$DRY" -eq 1 ]; then
    return
  fi
  if ! id -u "$user" >/dev/null 2>&1; then
    useradd --home "$home" --create-home --shell "$(nologin_shell)" "$user"
  fi
}

# --- sites (PHP) -----------------------------------------------------------
SSL_DOMAINS=()

apply_sites() {
  SSL_DOMAINS=()
  mkdir -p /etc/nginx/schela.d
  if [ "$DRY" -eq 0 ]; then
    find /etc/nginx/schela.d -name 'site-*.conf' -delete 2>/dev/null || true
    find /etc/php -path '*/fpm/pool.d/schela-*.conf' -delete 2>/dev/null || true
  fi

  while IFS= read -r site; do
    [ -n "$site" ] || continue
    domain="$(jq -r '.domain' <<<"$site")"
    user="$(jq -r '.systemUser' <<<"$site")"
    pool="$(jq -r '.pool' <<<"$site")"
    php="$(jq -r '.phpVersion' <<<"$site")"
    mem="$(jq -r '.memoryLimit' <<<"$site")"
    root="$(jq -r '.root' <<<"$site")"
    status="$(jq -r '.status' <<<"$site")"
    isolated="$(jq -r '.isolated' <<<"$site")"
    ssl="$(jq -r '.ssl' <<<"$site")"
    force="$(jq -r '.forceHttps // false' <<<"$site")"
    ip="$(jq -r '.ip // empty' <<<"$site")"
    ok_ipv4 "$ip" || ip=""
    http_bind="$(bind_http "$ip")"
    https_bind="$(bind_https "$ip")"

    [ "$status" = "active" ] || continue
    ok_domain "$domain" || { log "skip site, bad domain"; continue; }
    ok_user "$user" || { log "skip $domain, bad user"; continue; }
    ok_php "$php" || { log "skip $domain, bad php $php"; continue; }
    [[ "$pool" =~ ^[A-Za-z0-9._-]+$ ]] || { log "skip $domain, bad pool"; continue; }
    [[ "$mem" =~ ^[0-9]{2,4}M$ ]] || mem="256M"
    if [[ ! "$root" =~ ^/home/${user}/www(/[A-Za-z0-9_-][A-Za-z0-9._-]{0,63}){0,4}$ ]]; then
      [ "$root" = "null" ] || log "site $domain: document root outside www, using www"
      root="/home/${user}/www"
    fi

    log "site $domain  php $php  user $user"

    ensure_user "$user" "/home/$user"
    if [ "$DRY" -eq 0 ]; then
      ensure_home "$user" || continue
      # Repairs ownership of anything root created here before; chown -R
      # changes links themselves and does not follow them.
      chown -R "$user:$user" "/home/$user"
      as_user "$user" mkdir -p "/home/$user/www" "/home/$user/tmp" "/home/$user/logs" \
        || log "site $domain: could not create www, tmp or logs"
      as_user "$user" chmod 750 "/home/$user/www" || log "site $domain: could not set the mode of www"
      # nginx (www-data) must traverse the jail to serve static files / try_files.
      usermod -aG "$user" www-data 2>/dev/null || true
      printf '<?php echo htmlspecialchars(%s, ENT_QUOTES, "UTF-8");\n' "'${domain}'" \
        | as_user "$user" sh -c '[ -e "$1" ] || cat >"$1"' sh "/home/$user/www/index.php" \
        || log "site $domain: could not write the placeholder index.php"
    fi

    socket="/run/php/${pool}.sock"
    conf="$(render "$TEMPLATES/php-fpm-pool.conf" \
      __POOL__ "$pool" __USER__ "$user" __MEMORY__ "$mem")"
    if [ "$isolated" != "true" ] && [ "$isolated" != "t" ] && [ "$isolated" != "1" ]; then
      conf="$(printf '%s\n' "$conf" | grep -v open_basedir | grep -v disable_functions)"
    fi
    mkdir -p "/etc/php/${php}/fpm/pool.d"
    write_file "/etc/php/${php}/fpm/pool.d/schela-${pool}.conf" "$conf"

    if wants_ssl "$ssl" "$domain" && cert_live "$domain" && truthy "$force"; then
      vhost="$(render "$TEMPLATES/nginx-site-force.conf" \
        __DOMAIN__ "$domain" __BIND_80__ "$http_bind")"
    else
      vhost="$(render "$TEMPLATES/nginx-site.conf" \
        __DOMAIN__ "$domain" __ROOT__ "$root" __SOCKET__ "$socket" __BIND_80__ "$http_bind")"
    fi
    write_file "/etc/nginx/schela.d/site-${domain}.conf" "$vhost"
    if wants_ssl "$ssl" "$domain" && cert_live "$domain"; then
      sslv="$(render "$TEMPLATES/nginx-site-ssl.conf" \
        __DOMAIN__ "$domain" __ROOT__ "$root" __SOCKET__ "$socket" __BIND_443__ "$https_bind")"
      write_file "/etc/nginx/schela.d/site-${domain}-ssl.conf" "$sslv"
    else
      rm -f "/etc/nginx/schela.d/site-${domain}-ssl.conf"
    fi

    if wants_ssl "$ssl" "$domain"; then
      SSL_DOMAINS+=("$domain")
    fi
  done < <(jq -c '.sites // [] | .[]' "$STATE")

  if [ "$DRY" -eq 0 ]; then
    for ver in 8.1 8.2 8.3 8.4; do
      if [ -d "/etc/php/${ver}/fpm" ]; then
        systemctl enable --now "php${ver}-fpm" >/dev/null 2>&1 || true
        systemctl reload "php${ver}-fpm" >/dev/null 2>&1 || systemctl restart "php${ver}-fpm" || true
      fi
    done
  fi
}

# --- node apps -------------------------------------------------------------
apply_apps() {
  mkdir -p /etc/nginx/schela-apps.d /var/lib/schela/apps
  if [ "$DRY" -eq 0 ]; then
    find /etc/nginx/schela-apps.d -name 'app-*.conf' -delete 2>/dev/null || true
  fi

  while IFS= read -r app; do
    [ -n "$app" ] || continue
    name="$(jq -r '.name' <<<"$app")"
    domain="$(jq -r '.domain' <<<"$app")"
    ver="$(jq -r '.nodeVersion' <<<"$app")"
    port="$(jq -r '.port' <<<"$app")"
    entry="$(jq -r '.entry' <<<"$app")"
    status="$(jq -r '.status' <<<"$app")"
    ip="$(jq -r '.ip // empty' <<<"$app")"
    ok_ipv4 "$ip" || ip=""
    http_bind="$(bind_http "$ip")"
    https_bind="$(bind_https "$ip")"
    slug="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//')"
    unit="schela-app-${slug}"
    user="sa_${slug:0:20}"

    ok_domain "$domain" || { log "skip app, bad domain"; continue; }
    ok_node "$ver" || { log "skip $name, bad node $ver"; continue; }
    ok_port "$port" || { log "skip $name, bad port"; continue; }
    ok_user "$user" || { log "skip $name, bad user"; continue; }
    [[ "$entry" =~ ^[A-Za-z0-9._/-]+$ ]] || entry="index.js"
    [[ "$entry" != *".."* ]] || entry="index.js"

    log "app $name  node $ver  :$port"

    ensure_user "$user" "/home/$user"
    if [ "$DRY" -eq 0 ]; then
      ensure_home "$user" || continue
      chown -R "$user:$user" "/home/$user"
      as_user "$user" mkdir -p "/home/$user/app" || log "app $name: could not create app"
      printf 'PORT=%s\nNODE_VERSION=%s\n' "$port" "$ver" >"/var/lib/schela/apps/${user}.env"

      NODE_BIN="/usr/local/bin/node"
      if [ -d /usr/local/n/versions/node ]; then
        found="$(ls -d /usr/local/n/versions/node/"${ver}"* 2>/dev/null | sort -V | tail -1 || true)"
        if [ -n "$found" ] && [ -x "${found}/bin/node" ]; then
          NODE_BIN="${found}/bin/node"
        fi
      fi

      cat >"/etc/systemd/system/${unit}.service" <<UNIT
[Unit]
Description=Schela Node app ${name}
After=network.target
[Service]
Type=simple
User=${user}
Group=${user}
WorkingDirectory=/home/${user}/app
Environment=NODE_ENV=production
Environment=PORT=${port}
ExecStart=${NODE_BIN} /home/${user}/app/${entry}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
UNIT
      systemctl daemon-reload
      if [ "$status" = "running" ]; then
        systemctl enable --now "$unit" || true
      else
        systemctl disable --now "$unit" >/dev/null 2>&1 || true
      fi
    fi

    vhost="$(render "$TEMPLATES/nginx-node.conf" \
      __DOMAIN__ "$domain" __PORT__ "$port" __BIND_80__ "$http_bind")"
    write_file "/etc/nginx/schela-apps.d/app-${domain}.conf" "$vhost"
    if [[ ! "$domain" =~ \.(example|local|test)$ ]]; then
      if cert_live "$domain"; then
        sslv="$(render "$TEMPLATES/nginx-node-ssl.conf" \
          __DOMAIN__ "$domain" __PORT__ "$port" __BIND_443__ "$https_bind")"
        write_file "/etc/nginx/schela-apps.d/app-${domain}-ssl.conf" "$sslv"
      else
        rm -f "/etc/nginx/schela-apps.d/app-${domain}-ssl.conf"
      fi
      SSL_DOMAINS+=("$domain")
    fi
  done < <(jq -c '.apps // [] | .[]' "$STATE")
}

# --- site workers (queues, Horizon, scheduler) ------------------------------
SYSTEMD_DIR="${SCHELA_SYSTEMD_DIR:-/etc/systemd/system}"
# argv must be 1-32 non-empty strings without control characters.
WORKER_ARGV_OK='(.argv | type == "array") and (.argv | length >= 1 and length <= 32) and (.argv | all(type == "string" and length >= 1 and length <= 200 and (test("[[:cntrl:]]") | not)))'
# Quote one ExecStart= argument: inside double quotes systemd unescapes \\ and
# \", and expands %specifiers and $VARIABLES, so escape all four.
WORKER_SD='def sd: "\"" + (gsub("\\\\"; "\\\\") | gsub("\""; "\\\"") | gsub("%"; "%%") | gsub("\\$"; "$$")) + "\"";'

worker_instances() {
  # Every instance systemd knows about or will start at boot, for one worker id.
  {
    systemctl list-units --all --plain --no-legend --type=service "schela-worker-${1}@*.service" 2>/dev/null \
      | awk '{print $1}'
    for link in "$SYSTEMD_DIR"/multi-user.target.wants/schela-worker-"${1}"@*.service; do
      [ -e "$link" ] || [ -L "$link" ] || continue
      basename "$link"
    done
  } | grep -E "^schela-worker-${1}@[0-9]+\.service$" | sort -u
}

worker_stop() {
  # Disable and stop without waiting: a queue job may take minutes to finish.
  systemctl disable --now --no-block "$1" >/dev/null 2>&1 || true
}

apply_workers() {
  declare -A w_procs=() w_enabled=() w_changed=()
  local reload=0

  while IFS= read -r worker; do
    [ -n "$worker" ] || continue
    id="$(jq -r '.id' <<<"$worker")"
    [[ "$id" =~ ^[1-9][0-9]{0,8}$ ]] || { log "skip worker, bad id"; continue; }
    user="$(jq -r '.user' <<<"$worker")"
    php="$(jq -r '.phpVersion' <<<"$worker")"
    domain="$(jq -r '.domain' <<<"$worker")"
    name="$(jq -r '.name' <<<"$worker")"
    procs="$(jq -r '.processes' <<<"$worker")"
    stop="$(jq -r '.stopTimeout' <<<"$worker")"
    mem="$(jq -r '.memoryMb' <<<"$worker")"
    enabled="$(jq -r '.enabled' <<<"$worker")"

    ok_user "$user" || { log "skip worker $id, bad user"; continue; }
    ok_php "$php" || { log "skip worker $id, bad php"; continue; }
    ok_domain "$domain" || { log "skip worker $id, bad domain"; continue; }
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9\ ._-]{0,59}$ ]] || { log "skip worker $id, bad name"; continue; }
    [[ "$procs" =~ ^[1-8]$ ]] || { log "skip worker $id, bad process count"; continue; }
    [[ "$stop" =~ ^[0-9]{1,4}$ ]] && [ "$stop" -ge 5 ] && [ "$stop" -le 7200 ] \
      || { log "skip worker $id, bad stop timeout"; continue; }
    [[ "$mem" =~ ^[0-9]{2,4}$ ]] && [ "$mem" -ge 64 ] && [ "$mem" -le 8192 ] \
      || { log "skip worker $id, bad memory limit"; continue; }
    jq -e "$WORKER_ARGV_OK" <<<"$worker" >/dev/null || { log "skip worker $id, bad command"; continue; }

    exe="$(jq -r '.argv[0]' <<<"$worker")"
    if [ "$exe" = "php" ]; then
      exe="/usr/bin/php${php}"
    elif [[ "$exe" =~ ^/[A-Za-z0-9._/-]+$ ]] && [[ "$exe/" != */../* ]]; then
      :
    elif [[ "$exe" =~ ^[A-Za-z0-9._-][A-Za-z0-9._/-]*$ ]] && [[ "/$exe/" != */../* ]] && [[ "$exe" != */ ]]; then
      exe="/home/${user}/www/${exe}"
    else
      log "skip worker $id, bad executable"
      continue
    fi
    if [ "$DRY" -eq 0 ]; then
      uid="$(id -u "$user" 2>/dev/null || true)"
      # useradd gives site users UID_MIN..UID_MAX (1000-59999); never root,
      # system accounts, or nobody (65534).
      if [[ ! "$uid" =~ ^[0-9]+$ ]] || [ "$uid" -lt 1000 ] || [ "$uid" -ge 60000 ]; then
        log "skip worker $id, $user is not a site user"
        continue
      fi
    fi
    execline="$(jq -r --arg exe "$exe" "$WORKER_SD"' ([$exe] + .argv[1:]) | map(sd) | join(" ")' <<<"$worker")"

    content="[Unit]
Description=Schela worker ${name} for ${domain} (process %i)
After=network-online.target mysql.service mariadb.service postgresql.service redis-server.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
User=${user}
Group=${user}
WorkingDirectory=/home/${user}/www
Environment=HOME=/home/${user}
ExecStart=${execline}
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=${stop}
MemoryMax=${mem}M
TasksMax=256
UMask=0022
SyslogIdentifier=schela-worker-${id}
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/${user}
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target"

    unit_file="$SYSTEMD_DIR/schela-worker-${id}@.service"
    changed=0
    if [ ! -f "$unit_file" ] || [ "$(cat "$unit_file")" != "$content" ]; then
      write_file "$unit_file" "$content"
      changed=1
      reload=1
    fi
    w_procs[$id]="$procs"
    w_enabled[$id]=0
    truthy "$enabled" && w_enabled[$id]=1
    w_changed[$id]="$changed"
    log "worker $id ($name) on $domain: ${procs} process(es), $([ "${w_enabled[$id]}" -eq 1 ] && echo on || echo off)"
  done < <(jq -c '.workers // [] | .[]' "$STATE")

  # Workers removed from the panel (or whose site is gone).
  for unit_file in "$SYSTEMD_DIR"/schela-worker-*@.service; do
    [ -e "$unit_file" ] || continue
    wid="${unit_file##*/schela-worker-}"
    wid="${wid%@.service}"
    [[ "$wid" =~ ^[0-9]+$ ]] || continue
    [ -n "${w_procs[$wid]+x}" ] && continue
    if [ "$DRY" -eq 1 ]; then
      log "would remove worker $wid"
      continue
    fi
    log "remove worker $wid"
    while IFS= read -r inst; do
      [ -n "$inst" ] && worker_stop "$inst"
    done < <(worker_instances "$wid")
    rm -f "$unit_file" "$SYSTEMD_DIR"/multi-user.target.wants/schela-worker-"${wid}"@*.service
    reload=1
  done

  [ "$DRY" -eq 1 ] && return
  [ "$reload" -eq 1 ] && systemctl daemon-reload

  for id in "${!w_procs[@]}"; do
    procs="${w_procs[$id]}"
    if [ "${w_enabled[$id]}" -eq 1 ]; then
      for n in $(seq 1 "$procs"); do
        inst="schela-worker-${id}@${n}.service"
        if systemctl is-active --quiet "$inst"; then
          # Picks up a changed unit; SIGTERM lets the current job finish.
          [ "${w_changed[$id]}" -eq 1 ] && systemctl restart --no-block "$inst"
        else
          systemctl reset-failed "$inst" >/dev/null 2>&1 || true
        fi
        systemctl enable --now --no-block "$inst" >/dev/null 2>&1 || log "worker $id: could not start $inst"
      done
    fi
    while IFS= read -r inst; do
      [ -n "$inst" ] || continue
      n="${inst#schela-worker-${id}@}"
      n="${n%.service}"
      if [ "${w_enabled[$id]}" -eq 0 ] || [ "$n" -gt "$procs" ]; then
        worker_stop "$inst"
      fi
    done < <(worker_instances "$id")
  done
}

# --- firewall --------------------------------------------------------------
apply_firewall() {
  command -v ufw >/dev/null 2>&1 || return 0
  [ "$DRY" -eq 1 ] && { log "would apply ufw rules"; return; }
  ufw --force enable >/dev/null
  ufw default deny incoming >/dev/null
  ufw default allow outgoing >/dev/null
  # Always keep SSH so we cannot lock ourselves out.
  ufw allow 22/tcp >/dev/null || true
  ufw allow 80/tcp >/dev/null || true
  ufw allow 443/tcp >/dev/null || true
  while IFS= read -r rule; do
    [ -n "$rule" ] || continue
    enabled="$(jq -r '.enabled' <<<"$rule")"
    action="$(jq -r '.action' <<<"$rule")"
    proto="$(jq -r '.protocol' <<<"$rule")"
    port="$(jq -r '.port' <<<"$rule")"
    source="$(jq -r '.source' <<<"$rule")"
    [ "$enabled" = "true" ] || continue
    [ "$action" = "allow" ] || continue
    ok_port "$port" || continue
    [[ "$proto" =~ ^(tcp|udp|any)$ ]] || continue
    spec=""
    if [ "$proto" = "any" ]; then spec="$port"; else spec="${port}/${proto}"; fi
    if [ "$source" = "any" ]; then
      ufw allow "$spec" >/dev/null || true
    else
      ufw allow from "$source" to any port "$port" proto "$proto" >/dev/null || true
    fi
  done < <(jq -c '.firewall // [] | .[]' "$STATE")
}

# --- mail ------------------------------------------------------------------
apply_mail() {
  mod_on mail || return 0
  [ -d /etc/postfix ] || return 0
  [ "$DRY" -eq 1 ] && { log "would apply mail maps"; return; }
  mkdir -p /var/lib/schela/mail /var/mail/schela
  if ! id -u vmail >/dev/null 2>&1; then
    useradd --system --home /var/mail/schela --shell "$(nologin_shell)" vmail
  fi
  vuid="$(id -u vmail)"
  vgid="$(id -g vmail)"
  dove_ver="$(dovecot --version 2>/dev/null | awk '{print $1}' || true)"
  case "$dove_ver" in
    2.[4-9]*|[3-9]*) dove24=1 ;;
    *) dove24=0 ;;
  esac
  : >/var/lib/schela/mail/vmailbox
  : >/var/lib/schela/mail/vdomains
  : >/var/lib/schela/mail/users
  while IFS= read -r box; do
    [ -n "$box" ] || continue
    addr="$(jq -r '.address' <<<"$box")"
    status="$(jq -r '.status' <<<"$box")"
    hash="$(jq -r '.passwordHash // empty' <<<"$box")"
    quota="$(jq -r '.quotaMb // 2048' <<<"$box")"
    [ "$status" = "active" ] || continue
    [[ "$addr" =~ ^[A-Za-z0-9._+-]+@[A-Za-z0-9.-]+$ ]] || continue
    [[ "$quota" =~ ^[0-9]+$ ]] || quota=2048
    domain="${addr#*@}"
    localpart="${addr%@*}"
    printf '%s %s/\n' "$addr" "$domain/$localpart" >>/var/lib/schela/mail/vmailbox
    grep -qxF "$domain" /var/lib/schela/mail/vdomains 2>/dev/null || echo "$domain" >>/var/lib/schela/mail/vdomains
    mkdir -p "/var/mail/schela/${domain}/${localpart}/cur" \
             "/var/mail/schela/${domain}/${localpart}/new" \
             "/var/mail/schela/${domain}/${localpart}/tmp"
    if [[ "$hash" == \{SSHA512\}* ]]; then
      # Numeric uid/gid. A name here is dropped when NSS lookup fails at parse time,
      # and then IMAP never sees the mailbox.
      if [ "$dove24" -eq 1 ]; then
        extra="userdb_quota_storage_size=${quota}M"
      else
        extra="userdb_quota_rule=*:storage=${quota}M"
      fi
      printf '%s:%s:%s:%s::/var/mail/schela/%s/%s::%s\n' \
        "$addr" "$hash" "$vuid" "$vgid" "$domain" "$localpart" "$extra" \
        >>/var/lib/schela/mail/users
    fi
    mkdir -p /var/lib/schela/dkim
    if [ ! -f "/var/lib/schela/dkim/${domain}.private" ] && command -v opendkim-genkey >/dev/null 2>&1; then
      opendkim-genkey -D /var/lib/schela/dkim -s mail -d "$domain" >/dev/null 2>&1 || true
      if [ -f /var/lib/schela/dkim/mail.private ]; then
        mv /var/lib/schela/dkim/mail.private "/var/lib/schela/dkim/${domain}.private"
        mv /var/lib/schela/dkim/mail.txt "/var/lib/schela/dkim/${domain}.txt" 2>/dev/null || true
      fi
    fi
  done < <(jq -c '.mailboxes // [] | .[]' "$STATE")
  chown -R vmail:vmail /var/mail/schela
  postmap /var/lib/schela/mail/vmailbox 2>/dev/null || true
  postconf -e "virtual_mailbox_base = /var/mail/schela"
  postconf -e "virtual_mailbox_maps = hash:/var/lib/schela/mail/vmailbox"
  postconf -e "virtual_mailbox_domains = /var/lib/schela/mail/vdomains"
  postconf -e "virtual_minimum_uid = 100"
  postconf -e "virtual_uid_maps = static:${vuid}"
  postconf -e "virtual_gid_maps = static:${vgid}"
  if [ -d /etc/dovecot/conf.d ]; then
    if [ "$dove24" -eq 1 ]; then
      cat >/etc/dovecot/conf.d/99-schela.conf <<DOVE
# Managed by schela-apply (Dovecot 2.4)
mail_driver = maildir
mail_path = /var/mail/schela/%{user | domain}/%{user | username}
mail_uid = vmail
mail_gid = vmail
first_valid_uid = ${vuid}
auth_allow_cleartext = yes
auth_mechanisms = plain login
passdb passwd-file {
  passwd_file_path = /var/lib/schela/mail/users
}
userdb passwd-file {
  passwd_file_path = /var/lib/schela/mail/users
}
service auth {
  user = root
}
service imap-login {
  inet_listener imap {
    port = 143
  }
}
DOVE
    else
      cat >/etc/dovecot/conf.d/99-schela.conf <<DOVE
# Managed by schela-apply
protocols = imap
mail_location = maildir:/var/mail/schela/%d/%n
mail_uid = vmail
mail_gid = vmail
first_valid_uid = ${vuid}
passdb {
  driver = passwd-file
  args = scheme=SSHA512 username_format=%u /var/lib/schela/mail/users
}
userdb {
  driver = passwd-file
  args = username_format=%u /var/lib/schela/mail/users
}
disable_plaintext_auth = no
auth_mechanisms = plain login
service auth {
  user = root
}
service imap-login {
  inet_listener imap {
    port = 143
  }
}
DOVE
    fi
    chmod 644 /etc/dovecot/conf.d/99-schela.conf
    if getent group dovecot >/dev/null 2>&1; then
      chown root:dovecot /var/lib/schela/mail/users
    else
      chown root:root /var/lib/schela/mail/users
    fi
    chmod 640 /var/lib/schela/mail/users
    doveconf -n >/dev/null
    systemctl restart dovecot
  fi
  systemctl reload postfix >/dev/null 2>&1 || true
}

# --- cron ------------------------------------------------------------------
apply_cron() {
  [ "$DRY" -eq 1 ] && { log "would apply cron jobs"; return; }
  dest=/etc/cron.d/schela-jobs
  {
    echo "SHELL=/bin/sh"
    echo "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    echo "MAILTO="
    while IFS= read -r job; do
      [ -n "$job" ] || continue
      enabled="$(jq -r '.enabled' <<<"$job")"
      [ "$enabled" = "true" ] || [ "$enabled" = "t" ] || [ "$enabled" = "1" ] || continue
      user="$(jq -r '.user' <<<"$job")"
      sched="$(jq -r '.schedule' <<<"$job")"
      cmd="$(jq -r '.command' <<<"$job")"
      cwd="$(jq -r '.cwd // empty' <<<"$job")"
      ok_user "$user" || continue
      [[ "$sched" =~ ^[0-9*/,[:space:]-]+$ ]] || continue
      [[ "$cmd" != *$'\n'* ]] || continue
      [[ "$cmd" != *%* ]] || continue
      if [ -n "$cwd" ] && [[ "$cwd" =~ ^/home/[a-z_][a-z0-9_-]{0,31}/(www|app)$ ]]; then
        printf '%s %s cd %s && %s\n' "$sched" "$user" "$cwd" "$cmd"
      else
        printf '%s %s %s\n' "$sched" "$user" "$cmd"
      fi
    done < <(jq -c '.cron // [] | .[]' "$STATE")
  } >"$dest"
  chmod 644 "$dest"
}

# --- backups ---------------------------------------------------------------
apply_backups() {
  [ "$DRY" -eq 1 ] && { log "would apply backup cron"; return; }
  dest=/etc/cron.d/schela-backups
  {
    echo "SHELL=/bin/sh"
    echo "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    echo "MAILTO="
    while IFS= read -r job; do
      [ -n "$job" ] || continue
      enabled="$(jq -r '.enabled' <<<"$job")"
      [ "$enabled" = "true" ] || [ "$enabled" = "t" ] || [ "$enabled" = "1" ] || continue
      id="$(jq -r '.id' <<<"$job")"
      sched="$(jq -r '.schedule' <<<"$job")"
      [[ "$id" =~ ^[0-9]+$ ]] || continue
      [[ "$sched" =~ ^[0-9*/,[:space:]-]+$ ]] || continue
      printf '%s root /usr/local/sbin/schela-backup run %s\n' "$sched" "$id"
    done < <(jq -c '.backups // [] | .[]' "$STATE")
  } >"$dest"
  chmod 644 "$dest"
  mkdir -p /var/lib/schela/backups
  chown schela:schela /var/lib/schela/backups 2>/dev/null || true
}

# --- redis -----------------------------------------------------------------
redis_unit() {
  for u in redis-server redis; do
    if systemctl cat "${u}.service" >/dev/null 2>&1; then
      printf '%s' "$u"
      return
    fi
  done
  printf 'redis-server'
}

apply_redis() {
  unit="$(redis_unit)"
  if mod_on redis; then
    if [ "$DRY" -eq 1 ]; then
      log "would install/enable redis (${unit})"
      return
    fi
    if ! command -v redis-server >/dev/null 2>&1; then
      log "installing redis-server"
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -y >/dev/null
      apt-get install -y --no-install-recommends redis-server \
        || apt-get install -y --no-install-recommends redis
      unit="$(redis_unit)"
    fi
    if [ -d /etc/redis ]; then
      passfile=/var/lib/schela/redis.pass
      if [ ! -s "$passfile" ]; then
        umask 077
        openssl rand -hex 24 >"$passfile"
      fi
      chown schela:schela "$passfile" 2>/dev/null || true
      chmod 600 "$passfile"
      rpass="$(tr -d '\n' <"$passfile")"
      [[ "$rpass" =~ ^[a-f0-9]{32,64}$ ]] || die "bad redis password file"
      cat >/etc/redis/schela.conf <<EOF
# Managed by schela-apply — localhost only. Package is never removed on disable.
bind 127.0.0.1
protected-mode yes
port 6379
supervised systemd
requirepass ${rpass}
rename-command FLUSHALL ""
rename-command FLUSHDB ""
rename-command CONFIG ""
EOF
      if id -u redis >/dev/null 2>&1; then
        chown root:redis /etc/redis/schela.conf
      else
        chown root:root /etc/redis/schela.conf
      fi
      chmod 640 /etc/redis/schela.conf
      if [ -f /etc/redis/redis.conf ] && ! grep -q '/etc/redis/schela.conf' /etc/redis/redis.conf; then
        printf '\ninclude /etc/redis/schela.conf\n' >>/etc/redis/redis.conf
      fi
    fi
    log "redis on — enable and start ${unit} (starts at boot)"
    systemctl unmask "$unit" >/dev/null 2>&1 || true
    systemctl enable "$unit"
    systemctl restart "$unit" || systemctl start "$unit"
  else
    if [ "$DRY" -eq 1 ]; then
      log "would stop redis (keep package, do not start at boot)"
      return
    fi
    # Never uninstall. Stop now and disable so a reboot does not bring it back.
    if systemctl cat redis-server.service >/dev/null 2>&1 || systemctl cat redis.service >/dev/null 2>&1; then
      log "redis off — stop ${unit}, disable boot start (package stays)"
      systemctl disable --now redis-server >/dev/null 2>&1 || true
      systemctl disable --now redis >/dev/null 2>&1 || true
    fi
  fi
}

# --- dns -------------------------------------------------------------------
apply_dns() {
  mod_on dns || return 0
  [ -d /etc/bind ] || return 0
  [ "$DRY" -eq 1 ] && { log "would apply bind zones"; return; }
  mkdir -p /var/lib/schela/bind
  : >/etc/bind/schela-zones.conf
  while IFS= read -r zone; do
    [ -n "$zone" ] || continue
    zname="$(jq -r '.name' <<<"$zone")"
    serial="$(jq -r '.serial' <<<"$zone")"
    ok_domain "$zname" || continue
    [[ "$serial" =~ ^[0-9]+$ ]] || serial="$(date +%Y%m%d01)"
    zfile="/var/lib/schela/bind/${zname}.zone"
    {
      echo "\$TTL 300"
      echo "@ IN SOA ns1.${zname}. hostmaster.${zname}. (${serial} 3600 600 86400 300)"
      while IFS= read -r rec; do
        [ -n "$rec" ] || continue
        t="$(jq -r '.type' <<<"$rec")"
        n="$(jq -r '.name' <<<"$rec")"
        v="$(jq -r '.value' <<<"$rec")"
        ttl="$(jq -r '.ttl' <<<"$rec")"
        prio="$(jq -r '.priority // empty' <<<"$rec")"
        [[ "$t" =~ ^(A|AAAA|CNAME|MX|TXT|NS)$ ]] || continue
        [[ "$n" =~ ^[@A-Za-z0-9._*-]+$ ]] || continue
        [[ "$ttl" =~ ^[0-9]+$ ]] || ttl=300
        v="${v//$'\n'/}"
        v="${v//\"/}"
        if [ "$t" = "MX" ]; then
          [[ "$prio" =~ ^[0-9]+$ ]] || prio=10
          echo "${n} ${ttl} IN MX ${prio} ${v}."
        elif [ "$t" = "TXT" ]; then
          echo "${n} ${ttl} IN TXT \"${v}\""
        else
          echo "${n} ${ttl} IN ${t} ${v}"
        fi
      done < <(jq -c '.records // [] | .[]' <<<"$zone")
      if [ -f "/var/lib/schela/dkim/${zname}.txt" ]; then
        p="$(tr -d '\n" ' <"/var/lib/schela/dkim/${zname}.txt" | sed -n 's/.*p=\([^;]*\).*/\1/p')"
        if [ -n "$p" ]; then
          echo "mail._domainkey 300 IN TXT \"v=DKIM1; k=rsa; p=${p}\""
        fi
      fi
    } >"$zfile"
    chmod 644 "$zfile"
    echo "zone \"${zname}\" { type master; file \"${zfile}\"; };" >>/etc/bind/schela-zones.conf
  done < <(jq -c '.dns.zones // [] | .[]' "$STATE")
  grep -q 'schela-zones.conf' /etc/bind/named.conf.local 2>/dev/null || \
    echo 'include "/etc/bind/schela-zones.conf";' >>/etc/bind/named.conf.local
  named-checkconf >/dev/null 2>&1 && systemctl reload bind9 >/dev/null 2>&1 || true
}

issue_certs() {
  [ "$DRY" -eq 0 ] || return 0
  command -v certbot >/dev/null 2>&1 || { log "certbot missing"; return 0; }
  mkdir -p "$ACME_ROOT/.well-known/acme-challenge"
  chmod 755 /var/lib/schela "$ACME_ROOT" "$ACME_ROOT/.well-known" "$ACME_ROOT/.well-known/acme-challenge" || true
  echo '{' >"$CERTS_JSON.tmp"
  first=1
  NEW_CERTS=0
  for domain in "${SSL_DOMAINS[@]+"${SSL_DOMAINS[@]}"}"; do
    [ -n "$domain" ] || continue
    status="pending"
    message="Waiting for Let's Encrypt"
    expires=""
    if cert_live "$domain"; then
      status="live"
      message="Certificate is active"
      expires="$(openssl x509 -enddate -noout -in "/etc/letsencrypt/live/${domain}/fullchain.pem" 2>/dev/null | sed 's/notAfter=//' || true)"
    else
      out="$(mktemp)"
      set +e
      certbot certonly --webroot -w "$ACME_ROOT" \
        -d "$domain" \
        --non-interactive --agree-tos \
        --register-unsafely-without-email \
        --preferred-challenges http \
        --keep-until-expiring \
        >"$out" 2>&1
      rc=$?
      set -e
      if [ "$rc" -eq 0 ] && cert_live "$domain"; then
        status="live"
        message="Certificate issued"
        expires="$(openssl x509 -enddate -noout -in "/etc/letsencrypt/live/${domain}/fullchain.pem" 2>/dev/null | sed 's/notAfter=//' || true)"
        NEW_CERTS=$((NEW_CERTS + 1))
        log "certificate issued for $domain"
      else
        status="error"
        message="$(tail -n 8 "$out" | tr '\n' ' ' | sed 's/"/\\"/g' | cut -c1-400)"
        [ -n "$message" ] || message="Let's Encrypt failed (is DNS pointing here? port 80 open?)"
        log "certbot failed for $domain: $message"
        mkdir -p /var/log/schela
        cp "$out" "/var/log/schela/certbot-${domain}.log" || true
      fi
      rm -f "$out"
    fi
    [ "$first" -eq 1 ] || echo ',' >>"$CERTS_JSON.tmp"
    first=0
    printf '"%s":{"status":"%s","message":"%s","expires":"%s"}\n' \
      "$domain" "$status" "$message" "$expires" >>"$CERTS_JSON.tmp"
  done
  echo '}' >>"$CERTS_JSON.tmp"
  mv "$CERTS_JSON.tmp" "$CERTS_JSON"
  chmod 644 "$CERTS_JSON"
}

log "applying $(jq -r '.settings.hostname // "unknown"' "$STATE")"
apply_sites
apply_apps
apply_workers
apply_firewall
apply_mail
apply_dns
apply_cron
apply_backups
apply_redis

if [ "$DRY" -eq 0 ]; then
  mkdir -p "$ACME_ROOT/.well-known/acme-challenge"
  nginx -t
  systemctl reload nginx
  NEW_CERTS=0
  issue_certs
  if [ "${NEW_CERTS:-0}" -gt 0 ]; then
    log "attaching TLS vhosts"
    apply_sites
    apply_apps
    nginx -t
    systemctl reload nginx
  fi
fi
log "done"
